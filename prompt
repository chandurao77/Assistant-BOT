State Design

from typing import TypedDict, Annotated, Optional
import operator

class QueryQuokkaState(TypedDict):
    # Input
    raw_logs: str
    query: str
    
    # Parsed
    parsed_events: list
    time_range: dict
    
    # Classification
    stream_type: str          # "normal" | "anomaly" | "critical"
    anomaly_signals: list
    log_volume: int
    
    # Analysis
    summary: str
    analysis: str
    false_positive_flags: list
    confidence_score: float
    
    # Control flow
    retry_count: int
    errors: Annotated[list, operator.add]  # Append-only error log
    
    # Output
    final_report: dict
    slack_payload: Optional[dict]


Node Implementations

Parser Node

def parser_node(state: QueryQuokkaState) -> dict:
    try:
        parsed = parse_logs(state["raw_logs"])
        return {"parsed_events": parsed}
    except Exception as e:
        return {"errors": [f"Parser failed: {str(e)}"], "parsed_events": []}


StreamClassifier Node + Router

def stream_classifier_node(state: QueryQuokkaState) -> dict:
    classification = classify_stream(state["parsed_events"])
    return {
        "stream_type": classification["type"],
        "anomaly_signals": classification["signals"],
        "log_volume": classification["volume"]
    }

def route_after_classifier(state: QueryQuokkaState) -> str:
    if state["errors"]:
        return "error"
    if state["stream_type"] == "critical":
        return "critical_path"
    if state["stream_type"] == "anomaly":
        return "anomaly_path"
    return "light_path"   # Normal, low-volume logs


Evaluator Node (the key addition)

This is what you’re missing today — a node that checks if the Analyzer’s output is actually good before sending it to the user.

def evaluator_node(state: QueryQuokkaState) -> dict:
    score = evaluate_analysis_quality(
        analysis=state["analysis"],
        logs=state["parsed_events"],
        anomaly_signals=state["anomaly_signals"]
    )
    return {"confidence_score": score}

def route_after_evaluator(state: QueryQuokkaState) -> str:
    if state["confidence_score"] >= 0.70:
        return "assemble"
    if state["retry_count"] >= 2:
        return "assemble"   # Give up gracefully, flag low confidence
    return "repair"


Repair Node

def repair_node(state: QueryQuokkaState) -> dict:
    # Re-run analysis with more context or different prompt
    refined_analysis = re_analyze(
        state["parsed_events"],
        state["anomaly_signals"],
        previous_attempt=state["analysis"]
    )
    return {
        "analysis": refined_analysis,
        "retry_count": state["retry_count"] + 1
    }


Wiring It Together

from langgraph.graph import StateGraph, END

builder = StateGraph(QueryQuokkaState)

# Register all nodes
builder.add_node("parser", parser_node)
builder.add_node("time_window", time_window_node)
builder.add_node("stream_classifier", stream_classifier_node)
builder.add_node("summarizer", summarizer_node)
builder.add_node("light_summarizer", light_summarizer_node)
builder.add_node("analyzer", analyzer_node)
builder.add_node("evaluator", evaluator_node)
builder.add_node("repair", repair_node)
builder.add_node("assembler", assembler_node)
builder.add_node("slack_notifier", slack_notifier_node)
builder.add_node("error_handler", error_handler_node)

# Fixed edges
builder.set_entry_point("parser")
builder.add_edge("parser", "time_window")
builder.add_edge("time_window", "stream_classifier")
builder.add_edge("summarizer", "analyzer")
builder.add_edge("analyzer", "evaluator")
builder.add_edge("repair", "evaluator")       # Loop: repair → re-evaluate

# Conditional edges
builder.add_conditional_edges("stream_classifier", route_after_classifier, {
    "light_path":     "light_summarizer",
    "anomaly_path":   "summarizer",
    "critical_path":  "summarizer",
    "error":          "error_handler"
})

builder.add_conditional_edges("evaluator", route_after_evaluator, {
    "assemble": "assembler",
    "repair":   "repair"
})

# Critical path gets Slack notification before assembly
builder.add_conditional_edges("assembler", route_critical_to_slack, {
    "notify": "slack_notifier",
    "done":   END
})
builder.add_edge("slack_notifier", END)
builder.add_edge("light_summarizer", "assembler")
builder.add_edge("error_handler", END)

graph = builder.compile()


Autopilot Mode — The Right Way

Your current Autopilot fires on every anomaly and posts to Slack. With LangGraph you make this a proper interrupt gate:

from langgraph.checkpoint.postgres import PostgresSaver

checkpointer = PostgresSaver.from_conn_string(DATABASE_URL)

# In autopilot mode, pause before Slack notification
autopilot_graph = builder.compile(
    checkpointer=checkpointer,
    interrupt_before=["slack_notifier"]  # Human approves before posting
)

# Step 1 — Runs up to slack_notifier, pauses
thread = {"configurable": {"thread_id": incident_id}}
result = autopilot_graph.invoke({"raw_logs": log_batch}, config=thread)

# Step 2 — After human reviews in UI and approves:
autopilot_graph.invoke(None, config=thread)  # Resume → posts to Slack


This gives you the human approval gate you’d want before auto-posting incident alerts.

