# Assistant Bot — local configuration
# Copy this file to .env:   cp .env.example .env
# Everything runs on your machine: local LLM + embeddings through Ollama,
# vectors in Qdrant. No cloud API keys are needed.

# ── App ──────────────────────────────────────────────────────────────────────
# 'development' allows the built-in JWT secret. Set a real JWT_SECRET below
# before using any other value.
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Local models (Ollama) ────────────────────────────────────────────────────
# Chat model. Lighter options for small machines: llama3.2:3b, phi3:mini, qwen2.5:3b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=mistral-nemo
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_READ_TIMEOUT=300

# ── Vector store (Qdrant) ────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=confluence_docs
QDRANT_VECTOR_SIZE=768             # nomic-embed-text output dimension

# ── Documents ────────────────────────────────────────────────────────────────
# The default source is the ./test_docs folder (sample documents).
# Ingest them with:  POST /api/ingest/local   or   run.sh / run.ps1
# You can also upload files from the web UI.

# ── Security ─────────────────────────────────────────────────────────────────
# Shared API key required in the X-API-Key header for ingest endpoints.
# Leave empty to disable (fine for local use).
API_KEY=
# Secret for signing login tokens (only needed outside ENVIRONMENT=development).
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRE_HOURS=24
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=30

# ── Retrieval features ───────────────────────────────────────────────────────
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.97
SEMANTIC_CACHE_TTL=1800
CONTENT_GUARDRAIL_ENABLED=true     # regex PII/secret redaction before the LLM sees context
RERANK_ENABLED=true
RERANK_TOP_N=10
ENTITY_EXTRACTION_ENABLED=true
BM25_ENABLED=true                  # Okapi BM25 keyword scoring alongside vector search
CONTEXTUAL_CHUNKING_ENABLED=true   # prepend title/section to chunks before embedding
GRAPH_HOP_DEPTH=1                  # 0 = pure RAG, 1 = follow one hop of page links
GRAPH_MAX_EXPANSION=4

# ── RAG tuning (optional — defaults shown) ───────────────────────────────────
# CHUNK_SIZE=256
# CHUNK_OVERLAP=64                 # must be < CHUNK_SIZE
# RETRIEVAL_TOP_K=10
# RETRIEVAL_SCORE_THRESHOLD=0.30
# LLM_MAX_SOURCES=15
# MAX_CONTEXT_WORDS_PER_SOURCE=400
# MAX_HISTORY_TURNS=6
# OLLAMA_NUM_CTX=4096
# LLM_SYSTEM_PROMPT=               # override the built-in system prompt

# ── Maintenance ──────────────────────────────────────────────────────────────
CONVERSATION_MAX_AGE_DAYS=90       # 0 = keep forever
INGEST_AUTO_INTERVAL_HOURS=0       # 0 = manual ingest only

# ── Redis (optional cache) ───────────────────────────────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0
REDIS_TTL=3600

# ── Database (optional PostgreSQL; SQLite is the default) ────────────────────
# Start PostgreSQL with:  podman compose --profile postgres up -d
# DATABASE_URL=postgresql+asyncpg://assistant_bot:assistant_bot@postgres:5432/assistant_bot

# ── Observability (optional) ─────────────────────────────────────────────────
# Start ELK with:  podman compose --profile elk up -d
# ELK_ENABLED=true
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ── Optional: import from your own Confluence Cloud site ─────────────────────
# Not needed for local documents.
# CONFLUENCE_BASE_URL=https://your-site.atlassian.net
# CONFLUENCE_EMAIL=you@example.com
# CONFLUENCE_API_TOKEN=your_api_token
# CONFLUENCE_AUTH_TYPE=basic       # 'basic' (Cloud: email + token) or 'bearer' (Server PAT)
# CONFLUENCE_SPACE_KEYS=["DOCS"]
# CONFLUENCE_PAGE_LIMIT=500

# ── Optional: Jira / GitHub ingest ───────────────────────────────────────────
# JIRA_ENABLED=false
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your_api_token
# JIRA_PROJECTS=["DEMO"]
# JIRA_MAX_ISSUES=1000
# GITHUB_ENABLED=false
# GITHUB_TOKEN=ghp_your_personal_access_token
# GITHUB_REPOS=["your-user/your-repo"]
# GITHUB_MAX_FILES=500

# ── Optional: chat bots and SSO ──────────────────────────────────────────────
# SLACK_ENABLED=true
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_SIGNING_SECRET=your-signing-secret
# TEAMS_ENABLED=true
# TEAMS_APP_ID=your-app-id
# TEAMS_APP_SECRET=your-app-secret
# OIDC_ENABLED=false
# OIDC_ISSUER_URL=https://your-idp.example.com/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Secrets from files (optional) ────────────────────────────────────────────
# For any secret, set <NAME>_FILE to a file path and the file's content is used.
# Supported: JWT_SECRET, API_KEY, CONFLUENCE_API_TOKEN, DATABASE_URL, SLACK_BOT_TOKEN,
#            SLACK_SIGNING_SECRET, TEAMS_APP_SECRET, OIDC_CLIENT_SECRET,
#            JIRA_API_TOKEN, GITHUB_TOKEN
# Example:  echo "my-strong-key" > secrets/jwt_secret   then   JWT_SECRET_FILE=/run/secrets/jwt_secret
